# ==========================================================================
# Production env template — copy to .env.prod and fill in real values.
#
# Activate:
#   docker compose --env-file .env.prod up -d
# or, for a bare-metal run:
#   ENV_FILE=.env.prod python -m uvicorn app.main:app
#
# The backend's `_enforce_prod_safety` validator will REFUSE to boot if
# any of these are left at their dev defaults (debug=True, placeholder
# SECRET_KEY, seed admin password, MinIO keys). That's on purpose —
# better a loud crash at startup than a silent security hole.
# ==========================================================================

# ==== App ====
APP_NAME=ArtMarketplace
APP_ENV=production
DEBUG=false
# Generate a fresh one:  openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
API_V1_PREFIX=/api/v1
# Lock CORS down to your real domains. The regex below keeps only the
# production origins; drop the localhost regex used in dev.
ALLOWED_ORIGINS=https://artmarketplace.am,https://www.artmarketplace.am,https://admin.artmarketplace.am
ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?artmarketplace\.am$

# ==== Database (managed Postgres in prod) ====
# Pattern: postgresql+asyncpg://<user>:<pass>@<host>:<port>/<db>?sslmode=require
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASS@REPLACE_HOST:5432/artmarket

# ==== Redis / Celery (managed Redis in prod) ====
REDIS_URL=rediss://:REPLACE_PASS@REPLACE_HOST:6379/0
CELERY_BROKER_URL=rediss://:REPLACE_PASS@REPLACE_HOST:6379/1
CELERY_RESULT_BACKEND=rediss://:REPLACE_PASS@REPLACE_HOST:6379/2

# ==== JWT ====
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==== Object storage (Cloudflare R2 in prod) ====
# R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Public URL is your R2 public bucket domain (or a custom CDN CNAME).
S3_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://media.artmarketplace.am
S3_ACCESS_KEY=REPLACE_R2_ACCESS_KEY
S3_SECRET_KEY=REPLACE_R2_SECRET_KEY
S3_BUCKET=art-marketplace
S3_REGION=auto
S3_USE_SSL=true

# ==== Email (real SMTP in prod) ====
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=REPLACE_SENDGRID_API_KEY
SMTP_FROM=noreply@artmarketplace.am
SMTP_USE_TLS=true
ADMIN_NOTIFICATION_EMAIL=admin@artmarketplace.am

# ==== Watermark ====
WATERMARK_ENABLED=true
WATERMARK_TEXT=ArtMarketplace
WATERMARK_OPACITY=0.25

# ==== Image sizes (px width) ====
IMAGE_SIZE_THUMB=320
IMAGE_SIZE_MEDIUM=800
IMAGE_SIZE_LARGE=1920

# ==== i18n ====
SUPPORTED_LANGUAGES=hy,en,ru
DEFAULT_LANGUAGE=hy

# ==== Rate limiting ====
INQUIRY_RATE_LIMIT=5/minute

# ==== Seed admin (one-time; change immediately after first login) ====
ADMIN_EMAIL=admin@artmarketplace.am
# Must differ from the dev default. Change it right after the seed
# script creates the user — it's only used for bootstrap.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_FULL_NAME=Site Owner
