# ==========================================================================
# DEV SERVER env template (Hetzner box, subdomains on artmarketplace.duckdns.org).
# Copy to `.env` on the server and fill in the REPLACE_* values.
#
# Generate strong secrets with:
#   openssl rand -hex 32
# ==========================================================================

# ==== App ====
APP_NAME=ArtMarketplace
APP_ENV=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=https://admin-dev.artmarketplace.duckdns.org,https://app-dev.artmarketplace.duckdns.org
ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?artmarketplace\.duckdns\.org$

# ==== Database ====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=artmarket
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=artmarket
DATABASE_URL=postgresql+asyncpg://artmarket:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/artmarket

# ==== Redis / Celery ====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==== JWT ====
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==== Object storage (MinIO in-container for dev server) ====
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=https://api-dev.artmarketplace.duckdns.org/media
S3_ACCESS_KEY=REPLACE_WITH_STRONG_KEY
S3_SECRET_KEY=REPLACE_WITH_STRONG_SECRET
S3_BUCKET=art-marketplace
S3_REGION=us-east-1
S3_USE_SSL=false

# ==== Telegram notifications ====
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID

# ==== Email — leave empty for now; inquiries will just hit the DB ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@artmarketplace.duckdns.org
SMTP_USE_TLS=true
ADMIN_NOTIFICATION_EMAIL=admin@artmarketplace.duckdns.org

# ==== Watermark ====
WATERMARK_ENABLED=true
WATERMARK_TEXT=ArtMarketplace
WATERMARK_OPACITY=0.25

# ==== Image sizes (px width) ====
IMAGE_SIZE_THUMB=320
IMAGE_SIZE_MEDIUM=800
IMAGE_SIZE_LARGE=1920

# ==== i18n ====
SUPPORTED_LANGUAGES=hy,en,ru
DEFAULT_LANGUAGE=hy

# ==== Rate limiting ====
INQUIRY_RATE_LIMIT=5/minute

# ==== Seed admin (used by scripts/create_admin.py) ====
ADMIN_EMAIL=admin@artmarketplace.duckdns.org
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_FULL_NAME=Site Owner
