# ==== App ====
APP_NAME=ArtMarketplace
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_V1_PREFIX=/api/v1
# Next.js dev server runs on :3000 by default. Accept common localhost
# ports during dev; tighten this in staging/prod.
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5000,http://localhost:8080

# ==== Database ====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=artmarket
POSTGRES_PASSWORD=artmarket
POSTGRES_DB=artmarket
DATABASE_URL=postgresql+asyncpg://artmarket:artmarket@postgres:5432/artmarket

# ==== Redis / Celery ====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==== JWT ====
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==== Object storage (S3 compatible — MinIO dev / R2 prod) ====
# Internal endpoint (backend → minio inside docker network) stays 9000.
# Public URL is the *host* port that the browser uses — we map 9002 → 9000.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=art-marketplace
S3_REGION=us-east-1
S3_USE_SSL=false

# ==== Telegram notifications ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==== Email (SMTP) ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@artmarketplace.com
SMTP_USE_TLS=true
ADMIN_NOTIFICATION_EMAIL=admin@artmarketplace.com

# ==== Watermark ====
WATERMARK_ENABLED=true
WATERMARK_TEXT=ArtMarketplace
WATERMARK_OPACITY=0.25

# ==== Image sizes (px width) ====
IMAGE_SIZE_THUMB=320
IMAGE_SIZE_MEDIUM=800
IMAGE_SIZE_LARGE=1920

# ==== i18n ====
SUPPORTED_LANGUAGES=hy,en,ru
DEFAULT_LANGUAGE=hy

# ==== Rate limiting ====
INQUIRY_RATE_LIMIT=5/minute

# ==== Seed admin (used by scripts/create_admin.py) ====
ADMIN_EMAIL=admin@artmarketplace.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Site Owner
